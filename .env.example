# 실제 값은 .env 또는 실행 환경 변수로 주입한다. 이 파일에는 키 이름만 둔다.
# 미설정 시 애플리케이션은 기동을 거부한다.

DAMSO_DB_URL=
DAMSO_DB_USERNAME=
DAMSO_DB_PASSWORD=

# openssl rand -base64 32
DAMSO_COLUMN_ENCRYPTION_KEY=
# openssl rand -base64 32
DAMSO_JWT_SECRET=

DAMSO_OPENAI_API_KEY=

# --- F1 인증·회원가입 ---
# openssl rand -base64 32
DAMSO_CODE_HASH_KEY=

DAMSO_MAIL_HOST=
DAMSO_MAIL_PORT=
DAMSO_MAIL_FROM=
DAMSO_MAIL_USERNAME=
DAMSO_MAIL_PASSWORD=
# 로컬 Mailpit처럼 인증·TLS 없는 SMTP만 false (기본 true)
DAMSO_MAIL_STARTTLS=

DAMSO_REDIS_HOST=
DAMSO_REDIS_PORT=
DAMSO_REDIS_PASSWORD=

# 선택. 둘 다 넣으면 기동 시 슈퍼 관리자를 1회 생성한다(이미 있으면 변경 없음). 생성 후 지운다
DAMSO_SUPER_ADMIN_EMAIL=
DAMSO_SUPER_ADMIN_PASSWORD=

# --- F2 문의 접수·긴급 분류 ---
# Firebase 서비스 계정 JSON을 Base64로 인코딩한 값
DAMSO_FCM_CREDENTIALS=
